# ------------------------------------------------------------------
# ローカル開発用の環境変数のひな形。
#   cp .env.example .env.local   してから値を入れる
#   .env.local は git 管理外（絶対にコミットしない）
#
# 本番（Railway）へは Railway ダッシュボードの
#   サービス > Variables から同じキー名で登録する。
#   ※ ここに書いても本番には反映されない
# ------------------------------------------------------------------

# --- サーバー側でのみ使う秘密情報（VITE_ を付けないこと） ---
# 付けるとブラウザにバンドルされて全世界に公開される
# 取得: https://aistudio.google.com/apikey （無料枠あり・カード登録不要）
GEMINI_API_KEY=

# 使うモデル。未設定なら gemini-3.7-flash
#   gemini-3.7-flash        … 既定。最新の安定版
#   gemini-3.5-flash-lite   … 最速・最安。デモの応答速度を上げたいとき
#   gemini-2.5-flash        … 一世代前。上記が使えない場合の逃げ道
# ★モデルIDが弾かれたら、コードを触らずここ（本番は Railway の Variables）だけ変える
LLM_MODEL=

# ローカルの API サーバーのポート。
# ★このファイルはローカル専用。PORT を Railway の Variables にコピーしないこと。
#   Railway では「ドメイン生成時に選んだターゲットポート」が PORT として注入される。
#   ここの 3000 を持ち込むと、ターゲットポート(8080)と食い違って落ちる。
PORT=3000

# --- ブラウザに埋め込まれる公開設定（VITE_ プレフィックスが必要） ---
# 秘密情報を書かないこと
VITE_APP_NAME=Hackathon App
