# ------------------------------------------------------------------
# ローカル開発用の環境変数のひな形。
#   cp .env.example .env.local   してから値を入れる
#   .env.local は git 管理外（絶対にコミットしない）
#
# 本番（Vercel）へは Vercel ダッシュボードの
#   Settings > Environment Variables から同じキー名で登録する。
#   ※ ここに書いても本番には反映されない
# ------------------------------------------------------------------

# --- サーバー側でのみ使う秘密情報（VITE_ を付けないこと） ---
# 付けるとブラウザにバンドルされて全世界に公開される
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# 使う LLM プロバイダ: anthropic | openai
LLM_PROVIDER=anthropic

# --- ブラウザに埋め込まれる公開設定（VITE_ プレフィックスが必要） ---
# 秘密情報を書かないこと
VITE_APP_NAME=Hackathon App
